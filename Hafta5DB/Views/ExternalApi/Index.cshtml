@using BoardGameDB.Service
@model List<RestObjectDto>

<h2>Dış Kaynaklardan Gelen Oyun Verileri</h2>
<p class="text-muted">Bu veriler harici bir API servisi üzerinden anlık olarak çekilmektedir.</p>
<hr />

@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">
                            <small class="text-muted">ID: @item.Id</small>
                        </p>
                        @if (item.Data != null)
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var dataItem in item.Data)
                                {
                                    <li class="list-group-item">
                                        <strong>@dataItem.Key:</strong> @dataItem.Value.ToString()
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-warning">
        Veri çekilemedi veya dış servis yanıt vermiyor.
    </div>
}